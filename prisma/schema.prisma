// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id          String   @id @default(uuid())
  orderId     String   @unique
  name            String?
  firstName       String?
  secondName      String?
  firstSurname    String?
  secondSurname   String?
  email           String
  phone           String?
  rut             String?
  address         String?
  region          String?
  commune         String?
  country         String?  @default("Chile")
  serviceType String
  amount      Int
  status      String   @default("PENDING") // PENDING, PAID, FAILED
  paidAt      DateTime?
  reason      String?
  details     String?
  appointmentDate String?
  appointmentDates String[] @default([])
  attendeeTimeZone String?
  calBookingId    String?
  calBookingIds   String[] @default([])
  calEventTypeId  Int?
  siiReceiptIssued   Boolean  @default(false)
  siiReceiptIssuedAt DateTime?
  appointmentCancellations AppointmentCancellation[]
  createdAt       DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([status, paidAt])
  @@index([createdAt])
  @@index([siiReceiptIssued])
}

model AppointmentCancellation {
  id                      String   @id @default(uuid())
  bookingId               String
  booking                 Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  appointmentIndex        Int
  originalAppointmentDate String
  reason                  String?
  calCancelledAt          DateTime?
  emailSentAt             DateTime?
  rebookedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([bookingId, appointmentIndex, originalAppointmentDate])
  @@index([originalAppointmentDate])
  @@index([emailSentAt])
}

model Newsletter {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  active             Boolean   @default(false)
  confirmedAt        DateTime?
  confirmationToken  String?
  currentStep        Int       @default(0) // Indica en qué correo de la secuencia va (0 a 24)
  lastSentAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@index([confirmationToken])
}

model ConsentLog {
  id           String   @id @default(uuid())
  email        String
  type         String   // privacy | newsletter | cookies
  version      String   // versión de la política aceptada (yyyy-mm)
  granted      Boolean  @default(true)
  ip           String?
  userAgent    String?
  context      String?  // texto libre: "booking", "newsletter-signup", "cookie-banner"
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([type, createdAt])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
